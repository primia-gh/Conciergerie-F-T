{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "concierge-dev-attach",
      "url": "http://localhost:3000"
    },
    {
      "name": "concierge-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "concierge-prod-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000
    },
    {
      "name": "concierge-dev-certificats",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--use-system-ca", "node_modules/next/dist/bin/next", "dev"],
      "port": 3000
    }
  ]
}
