# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# design canvas — le fichier "seedé" embarque l'éditeur du outil de design
# (~2 Mo, régénérable via seed-canvas.mjs) ; seule la source .dc.html compte.
design/**/*.html
!design/**/*.dc.html

# typescript
*.tsbuildinfo
next-env.d.ts
