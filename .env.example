# Copier ce fichier vers .env.local (jamais commité) et renseigner les valeurs réelles.
# Aucun secret ne doit jamais être commité dans Git.

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Postgres + Auth + Storage + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connexion Postgres directe, utilisée par Drizzle pour les migrations
DATABASE_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email transactionnel (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- SMS (Twilio) — NOT IMPLEMENTED avant la Phase M11+ ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- IA (Claude API) — NOT IMPLEMENTED avant la Phase post-MVP pour Conciergerie
# Premium, mais REQUIS depuis le lot L1 de l'Agent IA Conciergerie F&T
# (src/lib/agent/) : c'est la clé qui fait tourner le chat de prospection.
ANTHROPIC_API_KEY=

# --- Agent IA Conciergerie F&T : alerte du gérant ---
# Adresse recevant les e-mails d'escalade et de validation (voir
# src/lib/agent/alert.ts). Sans cette variable, l'alerte est silencieusement
# ignorée (le journal `action` reste la trace de référence dans tous les cas).
GERANT_ALERT_EMAIL=

# --- Agent IA Conciergerie F&T : tâche planifiée de relance ---
# Vercel la génère automatiquement pour les Cron Jobs de ce projet ; sans
# elle, la route /api/cron/relances refuse toute requête (voir vercel.json).
CRON_SECRET=

# --- Cartes (Mapbox) — NOT IMPLEMENTED avant la Phase post-MVP ---
NEXT_PUBLIC_MAPBOX_TOKEN=
