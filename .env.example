# Copier ce fichier vers .env.local (jamais commité) et renseigner les valeurs réelles.
# Aucun secret ne doit jamais être commité dans Git.

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Postgres + Auth + Storage + Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connexion Postgres directe, utilisée par Drizzle pour les migrations
DATABASE_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email transactionnel (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- SMS (Twilio) — NOT IMPLEMENTED avant la Phase M11+ ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- IA (Claude API) — NOT IMPLEMENTED avant la Phase post-MVP ---
ANTHROPIC_API_KEY=

# --- Cartes (Mapbox) — NOT IMPLEMENTED avant la Phase post-MVP ---
NEXT_PUBLIC_MAPBOX_TOKEN=
